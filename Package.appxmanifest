<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://microsoft.com" xmlns:mp="http://microsoft.com" xmlns:uap="http://microsoft.com" IgnorableNamespaces="uap mp">
  
  <Properties>
    <DisplayName>Xbox Cloud Direct</DisplayName>
    <PublisherDisplayName>XboxCloudDirectCert</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="XboxCloudApp.App">
      <uap:VisualElements DisplayName="Xbox Cloud Direct" Description="Acceso directo a Xbox Cloud Gaming sin Edge" BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
